@page
@model DEPOTCONTAINER.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Khách hàng";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2><i class="bi bi-people"></i> Khách hàng</h2>
    <a asp-page="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Tạo mới</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>MST</th>
                    <th>Tên khách hàng</th>
                    <th>Người liên hệ</th>
                    <th>SĐT</th>
                    <th>Địa chỉ</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PagedData.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu.</td></tr>
                }
                @foreach (var c in Model.PagedData.Items)
                {
                    <tr>
                        <td><code>@c.TaxCode</code></td>
                        <td>@c.Name</td>
                        <td>@c.ContactPerson</td>
                        <td>@c.Phone</td>
                        <td>@c.Address</td>
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-page="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>