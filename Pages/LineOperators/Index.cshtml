@page
@model DEPOTCONTAINER.Pages.LineOperators.IndexModel
@{
    ViewData["Title"] = "Hãng khai thác";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2><i class="bi bi-building"></i> Hãng khai thác (Line Operator)</h2>
    <a asp-page="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Tạo mới</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Owner Code</th>
                    <th>Tên hãng</th>
                    <th>MST</th>
                    <th>Địa chỉ</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PagedData.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu.</td></tr>
                }
                @foreach (var op in Model.PagedData.Items)
                {
                    <tr>
                        <td><code class="fs-5">@op.OwnerCode</code></td>
                        <td>@op.Name</td>
                        <td>@op.TaxCode</td>
                        <td>@op.Address</td>
                        <td>@op.Phone</td>
                        <td>@op.Email</td>
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@op.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-page="Delete" asp-route-id="@op.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>