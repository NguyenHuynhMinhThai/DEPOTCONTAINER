@page
@model DEPOTCONTAINER.Pages.Containers.CreateModel
@{
    ViewData["Title"] = "Tạo Container mới";
}

<h2 class="mt-4"><i class="bi bi-plus-circle"></i> Tạo Container mới</h2>

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.ContainerNumber" class="form-label">Số Container <span class="text-danger">*</span></label>
                    <input asp-for="Input.ContainerNumber" class="form-control" placeholder="VD: CMAU1234567" />
                    <small class="form-text text-muted">11 ký tự: 4 chữ cái + 7 chữ số (Check digit Modulo 11)</small>
                    <span asp-validation-for="Input.ContainerNumber" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.IsoCode" class="form-label">Mã ISO</label>
                    <input asp-for="Input.IsoCode" class="form-control" placeholder="VD: 22G1, 45R1" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.LineOperatorId" class="form-label">Hãng khai thác</label>
                    <select asp-for="Input.LineOperatorId" class="form-select" asp-items="Model.LineOperators">
                        <option value="">-- Chọn --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.ContainerType" class="form-label">Loại container</label>
                    <select asp-for="Input.ContainerType" class="form-select" asp-items="Model.ContainerTypes"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Size" class="form-label">Kích thước (feet)</label>
                    <select asp-for="Input.Size" class="form-select" asp-items="Model.Sizes"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Category" class="form-label">Phân loại</label>
                    <select asp-for="Input.Category" class="form-select" asp-items="Model.Categories"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.MaxWeight" class="form-label">Trọng lượng tối đa (kg)</label>
                    <input asp-for="Input.MaxWeight" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.TareWeight" class="form-label">Trọng lượng vỏ (kg)</label>
                    <input asp-for="Input.TareWeight" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.ManufactureDate" class="form-label">Ngày sản xuất</label>
                    <input asp-for="Input.ManufactureDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.Condition" class="form-label">Tình trạng</label>
                    <select asp-for="Input.Condition" class="form-select" asp-items="Model.Conditions"></select>
                </div>
                <div class="col-12">
                    <label asp-for="Input.DamageDescription" class="form-label">Mô tả hư hỏng (nếu có)</label>
                    <textarea asp-for="Input.DamageDescription" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <hr class="my-4" />
            <div class="d-flex justify-content-between">
                <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}